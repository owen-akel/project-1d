# Copy this file to `.env` in the same folder and fill in your own key.
#   cp events-api/.env.example events-api/.env
#
# `.env` is gitignored and must stay that way — never commit a real key.

# Required. Free key from https://developer-acct.ticketmaster.com/user/register
# Without it the server exits on startup and the Local tab falls back to mock
# events instead of live ones.
TICKETMASTER_API_KEY=your_ticketmaster_consumer_key_here

# Optional. The app expects the API on 4000; change both if you move it.
PORT=4000

# Optional. CORS origin allowlist; `*` is fine for local development.
ALLOWED_ORIGIN=*
